    {
      "id": 5,
      "type": "stat",
      "title": "Сервис",
      "description": "Успех последнего сбора метрик Prometheus: 1 — сервис доступен, 0 — сбор не удался. Отсутствие данных отображается отдельно.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 0,
          "unit": "none",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"color": "red", "index": 0, "text": "Недоступен"},
                "1": {"color": "green", "index": 1, "text": "Доступен"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
