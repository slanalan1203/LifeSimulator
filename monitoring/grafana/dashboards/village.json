    {
      "id": 10,
      "type": "timeseries",
      "title": "Рождения, смерти и переселения за минуту",
      "description": "Среднее число событий за реальную минуту по данным последней минуты; это не игровой год. Все линии положительные: рождения и переселения увеличивают население, смерти уменьшают. Дробные значения возникают при расчёте скорости. Счётчики начинаются заново при запуске симулятора; rate учитывает их сброс. Данные появятся после перезапуска обновлённого симулятора и новых сборов Prometheus.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "decimals": 1,
          "unit": "suffix: /мин",
          "min": 0,
          "noValue": "Нет данных",
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"mode": "none", "group": "A"}
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Рождения"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "Смерти"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byName", "options": "Переселения"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": []},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(village_births_total{job=\"life-simulator\"}[1m]) * 60",
          "instant": false,
          "range": true,
          "legendFormat": "Рождения",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(village_deaths_total{job=\"life-simulator\"}[1m]) * 60",
          "instant": false,
          "range": true,
          "legendFormat": "Смерти",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
